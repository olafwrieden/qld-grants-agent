   "sub_program_title": {
    "sections": [
     {
      "type": "text",
      "data": "Transforming Queensland Manufacturing Grants Program"
     }
    ],
    "title": "Sub-program title"
   },
   "delivered_by": {
    "sections": [
     {
      "type": "text",
      "data": "DNRMMRRD"
     }
    ],
    "title": "Delivered by"
   },
   "grant_summary": {
    "sections": [
     {
      "type": "text",
      "data": "The new Transforming Queensland Manufacturing Grants Program (TQMGP) is helping shape the future of Queensland’s manufacturing sector. Through this program, the Queensland Government is investing in innovation, advanced technology, and job creation to strengthen the state’s economy and position Queensland as a leader in modern manufacturing.\nRound one has $12.5 million available, with eligible businesses able to apply for up to $1.5 million in matched grants.\nApplications for Round 1 close on Thursday 16 April 2026 at 1pm."
     }
    ],
    "title": "Summary"
   },
   "what_are_the_eligibility_criteria?": {
    "sections": [
     {
      "type": "text",
      "data": "Eligible businesses are Queensland-based manufacturers, registered for GST, holding an active Australian Business Number, employing between 5 and 200 employees and able to contribute at least 50% of the eligible project costs. Full eligibility requirements are available in the Applicant Guidelines."
     }
    ],
    "title": "What are the eligibility criteria?"
   },
   "url_link": {
    "sections": [
     {
      "type": "text",
      "data": "https://www.business.qld.gov.au/industries/manufacturing-retail/manufacturing/grant-programs/transforming"
     }
    ],
    "title": "URL Link"
   },
