    ],
    "title": "Summary"
   },
   "what_are_the_eligibility_criteria?": {
    "sections": [
     {
      "type": "text",
      "data": "Proposed projects must be community-led and improve wellbeing of community members or improve community social or economic outcomes which in turn will reduce future demand for government services in the community lowering service delivery costs. The proposal must identify the savings that would be re-invested in the community."
     }
