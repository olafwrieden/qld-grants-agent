{
  "name": "${SEARCH_INDEXER_NAME}",
  "description": "Pull of grant documents from Blob Storage: daily safety net (only changed blobs are processed) plus on demand from the weekly sync Function.",
  "dataSourceName": "${SEARCH_DATASOURCE_NAME}",
  "targetIndexName": "${SEARCH_INDEX_NAME}",
  "skillsetName": "${SEARCH_SKILLSET_NAME}",
  "schedule": {
    "interval": "P1D",
    "startTime": "2026-01-03T17:00:00Z"
  },
  "parameters": {
    "maxFailedItems": 0,
    "maxFailedItemsPerBatch": 0,
    "configuration": {
      "parsingMode": "json",
      "dataToExtract": "contentAndMetadata",
      "indexedFileNameExtensions": ".json"
    }
  },
  "fieldMappings": [],
  "outputFieldMappings": [
    { "sourceFieldName": "/document/titleVector", "targetFieldName": "titleVector" },
    { "sourceFieldName": "/document/descriptionVector", "targetFieldName": "descriptionVector" }
  ]
}
